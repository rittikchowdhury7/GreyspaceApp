"intro.checkin.title" = "Araw-araw na Check-In";
"intro.checkin.blurb" = "Kumuha ng 60-segundong snapshot ng iyong mood, stress, pasasalamat, at mga tala. Magdagdag ng mga larawan kung gusto mo. Pribado ito at nakaimbak lang sa iyong device.";
