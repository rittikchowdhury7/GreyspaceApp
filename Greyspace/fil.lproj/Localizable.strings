"intro.mindfulness.title" = "Isang-hingang Reset";
"intro.mindfulness.blurb" = "10 segundong reset. Huminga nang papasok habang lumalawak ang bilog; huminga palabas habang lumalambot. Gawin ang 1–3 cycle.";
