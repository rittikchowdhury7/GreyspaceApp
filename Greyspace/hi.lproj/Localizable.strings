"intro.thought.title" = "विचार सहायक";
"intro.thought.blurb" = "यह जगह चिपचिपे, अनुपयोगी विचारों के लिए है; ऐसे विचार जो बार-बार घूमते हैं या बोझ बनते हैं। हम धीरे-धीरे कुछ चरणों में आपको विचार को नए तरीके से देखने में मदद करेंगे। यह सुधारने या मिटाने के बारे में नहीं, बस भावना को नरम करने के बारे में है।";
"intro.thought.container.blurb" = "यह जगह चिपचिपे, अनुपयोगी विचारों के लिए है; ऐसे विचार जो लगातार घूमते हैं या बोझ बनते हैं। हम आपको कुछ चरणों में धीरे-धीरे मार्गदर्शन करेंगे ताकि आप उसे नरम नज़र से देख सकें। यह सुधारने के लिए नहीं, बस हल्का महसूस कराने के लिए है।";
"intro.thought.point1" = "एक वास्तविक विचार से शुरुआत करें (कोई सवाल नहीं)।";
