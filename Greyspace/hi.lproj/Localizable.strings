"intro.pressure.title" = "रोज़मर्रा के दबाव";
"intro.pressure.blurb" = "सांस्कृतिक और पारिवारिक दबावों के त्वरित कार्ड। एक नरम दृष्टिकोण के लिए कार्ड पलटें या वैकल्पिक AI मदद के साथ अपना जोड़ें।";
"intro.pressure.point1" = "हल्का दृष्टिकोण देखने के लिए कार्ड को टैप कर पलटें।";
